# Telegram
BOT_TOKEN=

# Database (Railway Postgres addon auto-populates this)
DATABASE_URL=

# Chains this bot covers: Base, Robinhood Chain, Ink
# RPC URLs are optional — sensible public defaults are baked into chains.ts.
# Override if you have a dedicated/paid RPC provider (recommended for
# production — public endpoints are rate-limited).
BASE_RPC_URL=
ROBINHOOD_RPC_URL=
INK_RPC_URL=

# Contract verification — only Base needs a key (Etherscan-compatible).
# Robinhood Chain and Ink both use Blockscout, which doesn't require one
# on the public API tier.
ETHERSCAN_API_KEY=

# Which chains the listener actually watches (comma-separated).
# Defaults to all three (base,robinhood,ink) if unset.
WATCHED_CHAINS=base,robinhood,ink

# OpenSea eligibility checks — required for the /eligibility command.
# Optional otherwise; the bot runs fine without it, that command just errors.
OPENSEA_API_KEY=

# Wallet encryption — REQUIRED once wallet features are used. Generate
# your OWN value (don't reuse any example key you see elsewhere — a key
# that's ever been displayed/logged anywhere isn't secret anymore).
# In Termux: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# mintgo.fun — no key needed, endpoint is public (https://mintgo.fun/api/seadrop-radar).
# Now wired in via mintgoPoller.ts as a second discovery source for
# Robinhood Chain and Ink (MintGo has no Base coverage).
