// Minimal persistence layer — just enough to fix the multi-user gap
// (per-user chain preferences + watchlist + alert routing) before
// discovery.ts goes live to more than one person. Wallet/portfolio
// tables come later in Phase 4 alongside those features.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String   @id @default(cuid())
  telegramId BigInt   @unique
  createdAt  DateTime @default(now())

  chainSubscriptions ChainSubscription[]
  watchlistEntries   WatchlistEntry[]
  wallets            Wallet[]
  autoMintConfig     AutoMintConfig?
  mintAttempts       MintAttempt[]
  trackedWallets     TrackedWallet[]
}

/// Custodial wallets the bot manages on behalf of a user. Every query
/// against this table MUST filter by userId as well as wallet id —
/// looking a wallet up by id alone (the old bot's bug) lets one user's
/// leaked/guessed wallet id expose another user's private key.
model Wallet {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  address              String
  /// AES-256-GCM ciphertext (iv + ciphertext + authTag, hex-encoded) — see walletCrypto.ts
  encryptedPrivateKey  String
  label                String
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())

  @@unique([userId, address])
}

/// Which chains a user wants discovery alerts for. Absence of any row
/// for a user on a given chain means "not subscribed" — alerts never
/// default to broadcasting to everyone.
model ChainSubscription {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  chain     String
  createdAt DateTime @default(now())

  @@unique([userId, chain])
}

model WatchlistEntry {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  contractAddress String
  chain           String
  createdAt       DateTime @default(now())

  @@unique([userId, contractAddress, chain])
}

/// One auto-mint config per user (not per-chain — same wallet/settings
/// apply everywhere since all our chains are EVM and the wallet works
/// identically across them). Off by default; enabling it is an explicit
/// user action, never a side effect of anything else.
model AutoMintConfig {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  walletId     String
  enabled      Boolean  @default(false)
  /// Safety cap — skip the mint rather than send if current gas price
  /// exceeds this. Null means no cap (not recommended, UI should warn).
  maxGasGwei   Float?
  updatedAt    DateTime @updatedAt
}

/// A whale wallet a user wants to watch. Notification-only by default —
/// autoCopy is a separate explicit opt-in, same pattern as AutoMintConfig.
/// Deliberately reuses the user's AutoMintConfig wallet + gas cap for
/// execution rather than adding a second wallet-selection flow — "your
/// auto-mint wallet snipes free mints AND copies tracked whales" is one
/// mental model instead of two.
model TrackedWallet {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  trackedAddress  String
  label           String
  autoCopy        Boolean  @default(false)
  /// Wei, as a string (avoids float precision loss). Required to enable
  /// autoCopy — there is no "no cap" option for copy-mint, unlike gas:
  /// an unbounded spend cap on a wallet you don't control the actions of
  /// is a materially different risk than an unbounded gas cap.
  maxSpendWei     String?
  createdAt       DateTime @default(now())

  @@unique([userId, trackedAddress])
}

/// History of mint attempts (manual, auto, or copy), success or failure.
/// Exists so a user can see what happened without digging through bot
/// logs, and gives Phase 4's portfolio tracking a starting point.
model MintAttempt {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  walletId        String
  contractAddress String
  chain           String
  trigger         String   // "manual" | "auto" | "copy"
  status          String   // "sent" | "failed"
  txHash          String?
  errorMessage    String?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}
